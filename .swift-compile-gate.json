{
  "ignore": [
    ".git",
    ".svn",
    ".hg",
    ".build",
    ".build/**",
    "DerivedData",
    "DerivedData/**",
    "Pods",
    "Pods/**",
    "Carthage",
    "Carthage/**",
    "build",
    "build/**",
    "vendor",
    "vendor/**",
    "node_modules",
    "node_modules/**",
    "*.designer.swift",
    "*.generated.*",
    "*.g.swift",
    "*.gen.*"
  ],
  "xcode_workspace": "",
  "xcode_project": "",
  "xcode_scheme": "",
  "xcode_destination": "generic/platform=macOS",
  "xcode_configuration": "Debug",
  "xcode_code_signing_allowed": false,
  "xcodebuild_arguments": [
    "-jobs",
    "1",
    "-derivedDataPath",
    ".build/swift-compile-gate-derived-data"
  ],
  "swift_build_arguments": [],
  "fail_on_any_warning": true,
  "critical_warning_patterns": [
    "will be an error in Swift 6",
    "\\bSendable\\b",
    "\\bnon[- ]?sendable\\b",
    "\\bactor[- ]isolated\\b",
    "\\bMainActor\\b",
    "\\bdata race\\b",
    "\\bconcurrently[- ]executing\\b"
  ],
  "critical_warning_exclude_patterns": [
    "Metadata extraction skipped"
  ]
}
