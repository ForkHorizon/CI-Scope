#!/usr/bin/env python3
from __future__ import annotations

import glob
import json
import os
import shutil
import signal
import subprocess
import sys
import tarfile
import time
from datetime import datetime, timezone
from pathlib import Path

ORG_LABELS = ["self-hosted", "macOS", "ARM64", "ci-scope"]
PRIVATE_LABELS = ["self-hosted", "macOS", "ARM64", "ci-scope-broker"]
DEFAULT_PROFILES = [
    {
        "id": "forkhorizon-organization",
        "title": "ForkHorizon organization",
        "scope": "ForkHorizon organization",
        "kind": "organization",
        "organization": "ForkHorizon",
        "labels": ORG_LABELS,
        "enabled": True,
    },
    {
        "id": "daliys-private",
        "title": "Daliys private repositories",
        "scope": "Daliys private repositories",
        "kind": "privateRepositories",
        "organization": None,
        "labels": PRIVATE_LABELS,
        "enabled": True,
    },
]
POLL_SECONDS = 15
MAX_RETRIES = 3
ROOT = Path.home() / "Library/Application Support/CI Scope/Broker"
REGISTRY_PATH = ROOT / "managed-repos.json"
STATE_PATH = ROOT / "broker-state.json"
JOBS_DIR = Path.home() / "Library/Caches/CI-Scope-Broker/jobs"
LOG_DIR = Path.home() / "Library/Logs/CI Scope/Broker"


def main() -> int:
    if "--help" in sys.argv or "-h" in sys.argv:
        print("CI Scope Broker: polls managed GitHub repos and runs one JIT runner job at a time.")
        return 0
    os.environ["PATH"] = ":".join(
        [
            "/opt/homebrew/bin",
            "/opt/homebrew/sbin",
            "/usr/local/bin",
            "/usr/bin",
            "/bin",
            "/usr/sbin",
            "/sbin",
            os.environ.get("PATH", ""),
        ]
    )
    ensure_dirs()
    state = read_state()
    while True:
        try:
            state = tick(state)
        except Exception as exc:
            state["lastError"] = str(exc)
            state["updatedAt"] = now()
            write_state(state)
        time.sleep(POLL_SECONDS)


def tick(state: dict) -> dict:
    registry = read_registry()
    profiles = enabled_profiles(registry)
    retries = state.get("retries") or {}
    active = state.get("active")

    if active and active.get("pid") and process_alive(active["pid"]):
        queue, statuses = collect_queue(registry, profiles)
        return save_state(active, queue, statuses, None, retries, profiles)

    if active:
        retries = update_retry(active, retries)

    queue, statuses = collect_queue(registry, profiles)
    dispatchable = [job for job in queue if retries.get(job["id"], 0) < MAX_RETRIES]
    if not dispatchable:
        return save_state(None, queue, statuses, None, retries, profiles)

    job = dispatchable[0]
    process = start_runner(job)
    active_job = dict(job)
    active_job["pid"] = process.pid
    write_state(save_state(active_job, queue, statuses, None, retries, profiles))
    return wait_for_runner(process, active_job, statuses, retries, profiles)


def collect_queue(registry: dict, profiles: list[dict]) -> tuple[list[dict], list[dict]]:
    jobs = []
    statuses = []
    for profile in profiles:
        try:
            repos = repositories_for_profile(profile, registry)
        except Exception as exc:
            statuses.append(repo_status(profile.get("scope") or profile["title"], "warning", 0, str(exc), profile, profile_labels(profile)))
            continue

        for repo in repos:
            slug = repo["slug"]
            labels = repo.get("labels") or profile_labels(profile)
            try:
                repo_jobs = queued_jobs(slug, labels, profile)
                jobs.extend(repo_jobs)
                statuses.append(repo_status(slug, "ok", len(repo_jobs), None, profile, labels))
            except Exception as exc:
                statuses.append(repo_status(slug, "warning", 0, str(exc), profile, labels))
    jobs.sort(key=lambda item: item.get("createdAt", ""))
    return jobs, statuses


def repositories_for_profile(profile: dict, registry: dict) -> list[dict]:
    labels = profile_labels(profile)
    if profile.get("kind") == "organization":
        organization = profile.get("organization")
        if not organization:
            raise RuntimeError(f"{profile.get('title') or 'Organization profile'} is missing organization.")
        return [{"slug": slug, "labels": labels} for slug in organization_repositories(organization)]

    repos = []
    for repo in registry.get("repos", []):
        if not repo.get("enabled", True):
            continue
        repos.append(
            {
                "slug": repo["slug"],
                "labels": repo.get("labels") or labels,
            }
        )
    return repos


def organization_repositories(organization: str) -> list[str]:
    command = [
        "gh",
        "repo",
        "list",
        organization,
        "--limit",
        "200",
        "--json",
        "nameWithOwner,isArchived",
        "--jq",
        "[.[] | select(.isArchived == false) | .nameWithOwner]",
    ]
    completed = subprocess.run(command, text=True, capture_output=True, timeout=60)
    if completed.returncode != 0:
        message = completed.stderr.strip() or completed.stdout.strip() or f"gh repo list failed: {organization}"
        raise RuntimeError(message)
    return json.loads(completed.stdout or "[]")


def queued_jobs(slug: str, labels: list[str], profile: dict) -> list[dict]:
    runs = gh_json(f"repos/{slug}/actions/runs?status=queued&per_page=20")
    result = []
    for run in runs.get("workflow_runs", []):
        jobs = gh_json(f"repos/{slug}/actions/runs/{run['id']}/jobs?per_page=100")
        for job in jobs.get("jobs", []):
            if job.get("status") != "queued":
                continue
            job_labels = job.get("labels") or []
            if not has_labels(job_labels, labels):
                continue
            result.append(job_payload(slug, run, job, labels, profile))
    return result


def start_runner(job: dict) -> subprocess.Popen:
    encoded = generate_jit_config(job)
    runner_dir = prepare_runner_dir(job)
    log_file = LOG_DIR / f"{safe_name(job['id'])}.log"
    log_handle = open(log_file, "a", encoding="utf-8")
    log_handle.write(f"[{now()}] starting JIT runner for {job['id']}\n")
    log_handle.flush()
    return subprocess.Popen(
        ["./run.sh", "--jitconfig", encoded],
        cwd=runner_dir,
        stdout=log_handle,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )


def wait_for_runner(process: subprocess.Popen, active: dict, statuses: list[dict], retries: dict, profiles: list[dict]) -> dict:
    exit_code = process.wait()
    active["exitCode"] = exit_code
    active["status"] = "completed" if exit_code == 0 else "failed"
    refreshed = refresh_run(active)
    if refreshed.get("status") == "queued":
        retries = update_retry(active, retries)
    return save_state(None, [], statuses, refreshed.get("lastError"), retries, profiles)


def generate_jit_config(job: dict) -> str:
    payload = {
        "name": f"ci-scope-{safe_name(job['repositorySlug'])}-{job['runId']}-{job.get('jobId') or 'run'}",
        "runner_group_id": 1,
        "labels": job.get("labels") or PRIVATE_LABELS,
        "work_folder": "_work",
    }
    output = gh_json(
        f"repos/{job['repositorySlug']}/actions/runners/generate-jitconfig",
        method="POST",
        payload=payload,
    )
    encoded = output.get("encoded_jit_config")
    if not encoded:
        raise RuntimeError("GitHub did not return encoded_jit_config.")
    return encoded


def prepare_runner_dir(job: dict) -> Path:
    archive = find_runner_archive()
    runner_dir = JOBS_DIR / safe_name(job["id"])
    if runner_dir.exists():
        shutil.rmtree(runner_dir)
    runner_dir.mkdir(parents=True)
    with tarfile.open(archive) as tar:
        tar.extractall(runner_dir)
    return runner_dir


def find_runner_archive() -> Path:
    patterns = [
        "~/actions-runner*/**/actions-runner-osx-arm64-*.tar.gz",
        "~/actions-runners*/**/actions-runner-osx-arm64-*.tar.gz",
    ]
    matches = []
    for pattern in patterns:
        matches.extend(glob.glob(os.path.expanduser(pattern), recursive=True))
    if not matches:
        raise RuntimeError("No cached actions-runner-osx-arm64 archive was found.")
    return Path(max(matches, key=lambda path: Path(path).stat().st_mtime))


def refresh_run(job: dict) -> dict:
    try:
        run = gh_json(f"repos/{job['repositorySlug']}/actions/runs/{job['runId']}")
        return {"status": run.get("status"), "lastError": None}
    except Exception as exc:
        return {"status": "unknown", "lastError": str(exc)}


def gh_json(endpoint: str, method: str = "GET", payload: dict | None = None) -> dict:
    command = ["gh", "api", "-X", method, endpoint]
    data = None
    if payload is not None:
        command.extend(["--input", "-"])
        data = json.dumps(payload)
    completed = subprocess.run(command, input=data, text=True, capture_output=True, timeout=60)
    if completed.returncode != 0:
        message = completed.stderr.strip() or completed.stdout.strip() or f"gh api failed: {endpoint}"
        raise RuntimeError(message)
    return json.loads(completed.stdout or "{}")


def job_payload(slug: str, run: dict, job: dict, labels: list[str], profile: dict) -> dict:
    job_id = job.get("id")
    run_id = run.get("id")
    return {
        "id": f"{slug}:{run_id}:{job_id}",
        "repositorySlug": slug,
        "workflowName": run.get("name") or "Workflow",
        "title": run.get("display_title") or run.get("name") or "Workflow run",
        "jobName": job.get("name") or "Queued job",
        "headBranch": run.get("head_branch") or "-",
        "status": job.get("status") or run.get("status") or "queued",
        "url": job.get("html_url") or run.get("html_url") or "",
        "createdAt": job.get("created_at") or run.get("created_at") or now(),
        "labels": labels,
        "runId": run_id,
        "jobId": job_id,
        "profileId": profile["id"],
        "profileTitle": profile["title"],
        "profileScope": profile["scope"],
    }


def save_state(active, queue, statuses, error, retries, profiles) -> dict:
    state = {
        "version": 1,
        "updatedAt": now(),
        "servicePID": os.getpid(),
        "active": active,
        "queue": queue,
        "repos": statuses,
        "profiles": profiles,
        "lastError": error,
        "retries": retries,
    }
    write_state(state)
    return state


def read_registry() -> dict:
    if not REGISTRY_PATH.exists():
        return {"version": 1, "repos": [], "profiles": DEFAULT_PROFILES}
    registry = json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))
    registry.setdefault("version", 1)
    registry.setdefault("repos", [])
    if not registry.get("profiles"):
        registry["profiles"] = DEFAULT_PROFILES
    return registry


def read_state() -> dict:
    if not STATE_PATH.exists():
        return {"version": 1, "queue": [], "repos": [], "retries": {}}
    try:
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return {"version": 1, "queue": [], "repos": [], "retries": {}}


def write_state(state: dict) -> None:
    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True), encoding="utf-8")
    tmp.replace(STATE_PATH)


def update_retry(job: dict, retries: dict) -> dict:
    result = dict(retries)
    result[job["id"]] = result.get(job["id"], 0) + 1
    return result


def repo_status(slug: str, state: str, count: int, error: str | None, profile: dict, labels: list[str]) -> dict:
    return {
        "slug": slug,
        "state": state,
        "queuedCount": count,
        "lastCheckedAt": now(),
        "lastError": error,
        "profileId": profile["id"],
        "profileTitle": profile["title"],
        "profileScope": profile["scope"],
        "labels": labels,
    }


def has_labels(labels: list[str], required_labels: list[str]) -> bool:
    available = {label.lower() for label in labels}
    return all(label.lower() in available for label in required_labels)


def profile_labels(profile: dict) -> list[str]:
    labels = profile.get("labels") or []
    return labels or PRIVATE_LABELS


def enabled_profiles(registry: dict) -> list[dict]:
    profiles = registry.get("profiles") or DEFAULT_PROFILES
    return [profile for profile in profiles if profile.get("enabled", True)]


def process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def safe_name(value: str) -> str:
    return "".join(char if char.isalnum() or char in "-_." else "-" for char in value)


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def ensure_dirs() -> None:
    ROOT.mkdir(parents=True, exist_ok=True)
    JOBS_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    raise SystemExit(main())
