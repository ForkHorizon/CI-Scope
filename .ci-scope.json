{
  "version": 1,
  "checks": [
    {
      "id": "code-linter",
      "type": "code-linter",
      "config": ".code-linter.json",
      "params": {"mode": "auto"}
    },
    {
      "id": "python-quality",
      "type": "python-quality"
    },
    {
      "id": "swift-quality",
      "type": "swift-quality",
      "config": ".swift-quality-gate.json",
      "params": {"run_build": false},
      "resources": ["xcode"]
    },
    {
      "id": "swift-compile",
      "type": "swift-compile",
      "config": ".swift-compile-gate.json",
      "resources": ["xcode"]
    }
  ]
}
